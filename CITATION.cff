repository-code: "https://github.com/NBISweden/klk4-isoform-analysis"
license: MIT
keywords:
  - KLK4
  - kallikrein-related peptidase 4
  - alternative splicing
  - Oxford Nanopore
  - direct RNA sequencing
  - long-read sequencing
  - prostate cancer
